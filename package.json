{
  "name": "joaovictordevportfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio of João Victor Barros das Merces: static single-page site built with Vite, TypeScript, Tailwind CSS, GSAP and Three.js.",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && html-validate index.html 404.html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource-variable/syne": "5.3.0",
    "gsap": "3.15.1",
    "lucide": "1.80.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "5.1.2",
    "autoprefixer": "10.7.0",
    "devicon": "2.18.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "html-validate": "11.22.1",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "browserslist": [
    "defaults",
    "not dead"
  ]
}
